{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yemen-opportunities-portal.local/schema/opportunities.v1.json",
  "title": "Yemen Opportunities Portal Dataset Schema",
  "description": "Formal schema contract for the Yemen Opportunities Portal bilingual opportunities dataset.",
  "type": "object",
  "required": ["schemaVersion", "lastUpdated", "opportunities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Semantic schema version of the dataset."
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Calendar date (YYYY-MM-DD) on which the dataset was last updated."
    },
    "opportunities": {
      "type": "array",
      "description": "List of manually verified opportunities.",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "required": ["ar", "en"],
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1,
          "description": "Arabic content."
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "description": "English content."
        }
      }
    },
    "opportunity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "organization",
        "country",
        "categories",
        "deadline",
        "officialSourceUrl",
        "verificationDate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique stable identifier in kebab-case."
        },
        "type": {
          "type": "string",
          "enum": [
            "scholarship",
            "internship",
            "course",
            "fellowship",
            "training",
            "competition",
            "grant",
            "exchange"
          ],
          "description": "Controlled opportunity type."
        },
        "title": {
          "$ref": "#/$defs/bilingualText",
          "description": "Bilingual opportunity title."
        },
        "organization": {
          "$ref": "#/$defs/bilingualText",
          "description": "Bilingual provider / organizer name."
        },
        "country": {
          "oneOf": [
            {
              "type": "object",
              "required": ["code", "name"],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "description": "ISO 3166-1 alpha-2 country code."
                },
                "name": {
                  "$ref": "#/$defs/bilingualText",
                  "description": "Bilingual country name."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Physical host country or null if international/global."
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "technology",
              "engineering",
              "health",
              "business",
              "humanities",
              "education",
              "arts",
              "general"
            ]
          },
          "description": "Applicable academic/professional disciplines."
        },
        "educationLevels": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "school",
              "bachelor",
              "master",
              "phd",
              "fresh-graduate",
              "professional",
              "open-to-all"
            ]
          },
          "description": "Applicable education levels or null if unspecified."
        },
        "fundingType": {
          "type": ["string", "null"],
          "enum": [
            "fully-funded",
            "partially-funded",
            "free",
            "paid-stipend",
            "self-funded",
            null
          ],
          "description": "Funding classification or null if unspecified."
        },
        "deliveryMode": {
          "type": ["string", "null"],
          "enum": [
            "online",
            "in-person",
            "hybrid",
            null
          ],
          "description": "Mode of delivery or null if unspecified."
        },
        "languages": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "description": "ISO 639-1 language codes or null if unspecified."
        },
        "applicationStatus": {
          "type": ["string", "null"],
          "enum": [
            "open",
            "upcoming",
            "closed",
            "suspended",
            null
          ],
          "description": "Manually verified status from official source or null if unspecified."
        },
        "deadline": {
          "type": "object",
          "required": ["type", "date"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["fixed", "rolling", "unspecified"]
            },
            "date": {
              "type": ["string", "null"],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "notes": {
              "type": ["object", "null"],
              "required": ["ar", "en"],
              "additionalProperties": false,
              "properties": {
                "ar": { "type": "string" },
                "en": { "type": "string" }
              }
            }
          },
          "description": "Application deadline details."
        },
        "shortDescription": {
          "oneOf": [
            { "$ref": "#/$defs/bilingualText" },
            { "type": "null" }
          ],
          "description": "Bilingual concise summary (1-2 sentences) or null."
        },
        "eligibilityNote": {
          "oneOf": [
            { "$ref": "#/$defs/bilingualText" },
            { "type": "null" }
          ],
          "description": "Key verified eligibility criteria or null."
        },
        "officialSourceUrl": {
          "type": "string",
          "pattern": "^https://.+",
          "description": "Official HTTPS announcement URL."
        },
        "applicationUrl": {
          "type": ["string", "null"],
          "pattern": "^https://.+",
          "description": "Direct HTTPS application link if distinct from official source, or null."
        },
        "verificationDate": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Calendar date (YYYY-MM-DD) on which the record was manually verified."
        }
      }
    }
  }
}
